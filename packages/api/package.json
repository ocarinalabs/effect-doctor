{
  "name": "@effect-doctor/api",
  "version": "0.1.0",
  "private": true,
  "description": "Effect-based scan and comparison workflows for Effect Doctor.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "setup:effect": "effect-tsgo patch --typescript --no-oxlint",
    "test": "vp test run",
    "test:watch": "vp test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect-doctor/core": "workspace:*",
    "@effect/platform-node": "4.0.0-rc.113",
    "@effect/tsgo": "0.45.0",
    "@oxlint/plugins": "1.82.0",
    "effect": "4.0.0-rc.113",
    "oxlint": "1.82.0",
    "oxlint-plugin-effect-doctor": "workspace:*",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
