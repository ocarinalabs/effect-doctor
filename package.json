{
  "name": "effect-doctor-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "audit:dependencies": "turbo run //#audit:dependencies:repo",
    "bench": "turbo run bench --filter=dr-effect",
    "build": "turbo run build",
    "catalog:check": "turbo run catalog:check --filter=@effect-doctor/core",
    "catalog:generate": "turbo run catalog:generate --filter=@effect-doctor/core",
    "check": "turbo run catalog:check typecheck test //#lint:repo //#test:action:repo",
    "doctor:self": "turbo run doctor:self --filter=dr-effect",
    "dev": "turbo run dev",
    "fix": "turbo run //#fix:repo",
    "lint": "turbo run //#lint:repo",
    "setup:effect": "turbo run setup:effect --filter=@effect-doctor/api",
    "test": "turbo run test",
    "test:action": "turbo run //#test:action:repo",
    "test:watch": "turbo run test:watch",
    "typecheck": "turbo run typecheck",
    "verify:package": "turbo run verify:package",
    "verify:release": "turbo run verify:release",
    "audit:dependencies:repo": "bun audit --audit-level=high",
    "fix:repo": "ultracite fix",
    "lint:repo": "ultracite check",
    "test:action:repo": "node --test action/tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "turbo": "2.10.12",
    "typescript": "7.0.2",
    "ultracite": "7.11.1",
    "vite-plus": "0.3.1",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "bun@1.4.0"
}
